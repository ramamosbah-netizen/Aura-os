node_modules/
dist/
.next/
# NEXT_DIST_DIR lets a second local server build elsewhere (see apps/web/next.config.ts).
# Without this the output is untracked-but-not-ignored and lands in the next commit.
.next-e2e*/
.turbo/
out/
coverage/
*.log
# Anything env-shaped is ignored by DEFAULT; only examples are re-included. The previous rules
# enumerated exact names (.env, .env.local, .env.*.local), so `apps/api/.env.local.wave0-backup`
# — a real backup holding live database credentials — matched none of them and sat in git status
# as an ordinary untracked file, one `git add -A` away from a PUBLIC repository. The commit-time
# secret scan would likely have caught it, but that is a last line, not a first one. Listing the
# names you expect fails the moment someone makes a new one; ignore the family, name the
# exceptions.
.env*
!.env.example
!.env.*.example
.DS_Store
*.tsbuildinfo
# Generated by next dev/build; the two commands emit different import paths,
# so a tracked copy churns on every switch. tsconfig includes both type globs.
/apps/web/next-env.d.ts
.aura-storage/
# Safety net: compiled output must live in dist/, never emitted into src/
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map

# Playwright
/apps/web/playwright-report/
/apps/web/test-results/
.claude/

# Operational recovery artifacts from scripts/merge-duplicate-accounts.mjs — specific to one
# database, never source. Keep them where they were generated.
apps/api/scripts/undo-account-merge-*.json

# Security-posture documents: this repository is PUBLIC, and these state what is unprotected
# and when. Kept on the machine, never pushed — same decision as the blockers report.
docs/reports/*consolidated-gap-register-v2.md
docs/reports/*g20-compliance-discovery.md
# Same decision, same reason: the master audit is a register of what is unprotected and when
# (P0/P1 rows, RLS exemptions, unreachable endpoints, the limitations that cap each finding).
# It names no credential and withholds the project ref, but the genre is the point, not the
# redaction. Kept on the machine with the other two registers.
docs/master-audit/
