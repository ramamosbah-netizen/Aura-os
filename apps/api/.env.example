PORT=4000

# Authentication. In production, prefer a hosted IdP via AUTH_JWKS_URL. For local
# self-issued sessions, keep secret values in *_FILE mounts (never commit them).
# AUTH_JWT_SECRET_FILE=/run/secrets/aura-jwt-secret
# AUTH_DEV_PASSWORD_FILE=/run/secrets/aura-master-admin-password
# AUTH_REQUIRED=true
# AUTH_DEFAULT_TENANT=dev-tenant
# AUTH_MASTER_ADMIN_USER=u-admin
# AUTH_MASTER_ADMIN_TENANT=dev-tenant
# AUTH_LOCAL_LOGIN_USERS=u-admin
# AUTH_SESSION_TTL_SECONDS=28800
# AUTH_ALLOW_DEV_TOKENS=false

# Supabase (Postgres + Auth + RLS) — wired in the next increment
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Intelligence layer — AI providers (Claude is the default)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Embeddings (pgvector RAG). Unset -> deterministic offline LEXICAL embedding.
# Set EMBEDDINGS_API_KEY for real neural embeddings via an OpenAI-compatible API.
# The model must emit EMBEDDINGS_DIMS-dimensional vectors matching the vector() column.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1   # or https://api.voyageai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small         # 1536 dims
# EMBEDDINGS_DIMS=1536

# Official Meta WhatsApp Business Cloud API (never use personal WhatsApp/Web sessions).
# The webhook URL must be publicly reachable by Meta and point to /api/v1/whatsapp/webhook.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v23.0

# Fleet telematics webhook (POST /api/v1/fleet/telemetry/webhook). The provider signs the raw body:
# header X-AURA-Signature: sha256=<hex HMAC-SHA256 of the body under the secret>. Fail-closed — with
# either variable unset, or a secret shorter than 32 characters, every call is refused (503).
# One secret binds ONE tenant for this deployment.
# FLEET_TELEMETRY_WEBHOOK_SECRET=
# FLEET_TELEMETRY_TENANT_ID=
# FLEET_TELEMETRY_COMPANY_ID=
